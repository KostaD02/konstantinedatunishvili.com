---
layout: "base.njk"
ogType: "article"
schemaType: "BlogPosting"
---

{% set imageSize = image | imageSize %}
<section class="kd-section kd-measure-md">
  <article class="kd-prose">
    <img
      class="kd-h-auto"
      src="{{ image }}"
      alt="{{ imageAlt }}"
      width="{{ imageSize.width }}"
      height="{{ imageSize.height }}"
      fetchpriority="high"
      decoding="async"/>
    <h1>{{ title }}</h1>
    {{ content | safe }}
  </article>
</section>
