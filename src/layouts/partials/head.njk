<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{% if title %}{{ title }} | {% endif %}Konstantine Datunishvili</title>
  <link rel="canonical" href="{{ consts.site }}{{ page.url | replace(".html", "") }}"/>
  <meta name="theme-color" content="#0a192f"/>
  <meta name="description" content="{{ description | default('Personal Website') }}"/>
  <meta property="og:type" content="{{ ogType | default('website') }}"/>
  <meta property="og:site_name" content="Konstantine Datunishvili"/>
  <meta property="og:locale" content="en_US"/>
  <meta property="og:url" content="{{ consts.site }}{{ page.url | replace(".html", "") }}"/>
  <meta property="og:title" content="{{ title | default('Konstantine Datunishvili - Portfolio') }}"/>
  <meta property="og:description" content="{{ description | default('Personal Website') }}"/>
  <meta property="og:image" content="{{ consts.site }}{{ image | default('/assets/images/logo_500x500.png') }}"/>
  <meta property="og:image:alt" content="{{ imageAlt | default('Konstantine Datunishvili') }}"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="{{ title | default('Konstantine Datunishvili - Portfolio') }}"/>
  <meta name="twitter:description" content="{{ description | default('Personal Website') }}"/>
  <meta name="twitter:image" content="{{ consts.site }}{{ image | default('/assets/images/logo_500x500.png') }}"/>
  <meta name="twitter:image:alt" content="{{ imageAlt | default('Konstantine Datunishvili') }}"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Raleway:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"/>
  <link rel="icon" type="image/x-icon" href="/assets/icons/favicon.ico"/>
  <link rel="alternate" type="application/atom+xml" title="Konstantine Datunishvili - Blog" href="/feed.xml"/>
  <link rel="stylesheet" href="/styles/style.css"/>
  {% include "schema.njk" %}
  <script>
    if ("IntersectionObserver" in window) {
      document.documentElement.classList.add("kd-js");
    }
    try {
      if (sessionStorage.getItem("kd-intro")) {
        document.documentElement.classList.add("kd-no-intro");
      }
      sessionStorage.setItem("kd-intro", "1");
    } catch (error) {}
  </script>
</head>
