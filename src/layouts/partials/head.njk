<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{ title }} {% if title %} | {% endif %} Konstantine Datunishvili</title>
  <meta name="theme-color" content="#0a192f"/>
  <meta name="title" content="{{ title | default('Konstantine Datunishvili - Portfolio') }}"/>
  <meta name="description" content="{{ description | default('Personal Website') }}"/>
  <meta name="keywords" content="konstantine, datunishvili, konstantine datunishvili, kosta, kosta datunishvili, კონსტანტინე,დათუნიშვილი, კონსტანტინე დათუნიშვილი, კოსტა დათუნიშვილი, {{ keywords | default('') }}, {{ chips | default('') }}"/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content="https://konstantinedatunishvili.com{{ page.url }}"/>
  <meta property="og:title" content="{{ title | default('Konstantine Datunishvili - Portfolio') }}"/>
  <meta property="og:description" content="{{ description | default('Personal Website') }}"/>
  <meta property="og:image" content="https://konstantinedatunishvili.com{{ image | default('/assets/images/logo_500x500.png') }}"/>
  <meta property="twitter:card" content=" summary_large_image"/>
  <meta property="twitter:url" content="https://konstantinedatunishvili.com{{ page.url }}"/>
  <meta property="twitter:title" content="{{ title | default('Konstantine Datunishvili - Portfolio') }}"/>
  <meta property="twitter:description" content="{{ description | default('Personal Website') }}"/>
  <meta property="twitter:image" content="https://konstantinedatunishvili.com{{ image | default('/assets/images/logo_500x500.png') }}"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Raleway:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"/>
  <link rel="icon" type="image/x-icon" href="/assets/icons/favicon.ico"/>
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" id="aos-css"/>
  <link rel="stylesheet" href="/styles/style.css"/>
</head>
