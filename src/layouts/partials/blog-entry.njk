<article class="kd-teaser kd-reveal kd-animate-slide-in-start">
  <a href="/blog/{{ post.page.fileSlug }}/" class="kd-link kd-teaser__title">
    <h2>
      {{ post.data.title }}
    </h2>
  </a>
  <p class="kd-teaser__text">{{ post.data.description }}</p>
  <div class="kd-teaser__tags">
    {% for chip in post.data.chips %}
      <span class="kd-chip">{{ chip }}</span>
    {% endfor %}
  </div>
  <time class="kd-teaser__meta" datetime="{{ post.data.date }}">
    {{ post.data.date | blogDate }}
  </time>
</article>
