---
layout: "base.njk"
noindex: true
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - post
permalink: /tags/{{ tag | lower }}.html
eleventyComputed:
  title: 'Posts tagged "{{ tag }}"'
  description: 'Every post on konstantinedatunishvili.com tagged {{ tag }}, covering front-end development, Angular, Nx and the web.'
---

<section class="kd-section kd-measure-xxxl">
  <h1 class="kd-fw-medium">Posts tagged “{{ tag }}”</h1>
  {% include "tag-list.njk" %}
  <div class="kd-d-flex kd-flex-column kd-gap-5 kd-mt-5">
    {%- for post in collections[tag] | reverse -%}
      {% include "blog-entry.njk" %}
    {%- endfor -%}
  </div>
</section>
